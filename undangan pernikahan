<!DOCTYPE html><html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Undangan Pernikahan</title><link href="https://fonts.googleapis.com/css2?family=Playfair+Display&family=Poppins&display=swap" rel="stylesheet"><style>
body{
  margin:0;
  font-family:'Poppins',sans-serif;
  background:#fdfaf6;
  color:#333;
  text-align:center;
}

.cover{
  height:100vh;
  background:url('https://images.unsplash.com/photo-1519741497674-611481863552') center/cover;
  display:flex;
  justify-content:center;
  align-items:center;
  color:white;
}

.overlay{
  background:rgba(0,0,0,0.6);
  padding:30px;
  border-radius:20px;
}

h1{
  font-family:'Playfair Display',serif;
  font-size:40px;
}

button{
  padding:10px 25px;
  border:none;
  border-radius:25px;
  background:gold;
  cursor:pointer;
}

section{
  padding:60px 20px;
}

.card{
  background:white;
  padding:20px;
  margin:10px auto;
  border-radius:15px;
  max-width:400px;
  box-shadow:0 10px 30px rgba(0,0,0,0.1);
}

.gallery img{
  width:120px;
  margin:5px;
  border-radius:10px;
}

.fade{
  opacity:0;
  transform:translateY(30px);
  transition:1s;
}
.show{
  opacity:1;
  transform:translateY(0);
}
</style></head><body><!-- COVER --><div class="cover">
  <div class="overlay">
    <h1 id="nama"></h1>
    <p id="tamu"></p>
    <button onclick="buka()">Buka Undangan</button>
  </div>
</div><!-- MEMPELAI --><section class="fade">
  <h2>Mempelai</h2>
  <div class="card">
    <h3 id="pria"></h3>
  </div>
  <div class="card">
    <h3 id="wanita"></h3>
  </div>
</section><!-- GALERI --><section class="fade">
  <h2>Galeri</h2>
  <div class="gallery">
    <img src="https://picsum.photos/200?1">
    <img src="https://picsum.photos/200?2">
    <img src="https://picsum.photos/200?3">
  </div>
</section><!-- ACARA --><section class="fade">
  <h2>Acara</h2>
  <div class="card">
    <p id="tanggal"></p>
    <p id="tempat"></p>
    <a id="maps" target="_blank">📍 Buka Maps</a>
  </div>
</section><!-- COUNTDOWN --><section class="fade">
  <h2>Menuju Hari Bahagia</h2>
  <h3 id="countdown"></h3>
</section><audio id="music" loop>
<source src="https://www.bensound.com/bensound-music/bensound-romantic.mp3">
</audio><script>

// ✏️ EDIT DI SINI AJA
const data={
  pria:"Nama Pria",
  wanita:"Nama Wanita",
  tanggal:"2027-01-10T09:00:00",
  tempat:"Lokasi Pernikahan",
  maps:"https://maps.google.com/?q=jakarta"
};

// NAMA TAMU OTOMATIS
const url=new URLSearchParams(window.location.search);
const tamu=url.get('to')||"Tamu Undangan";

document.getElementById("tamu").innerText="Kepada "+tamu;
document.getElementById("nama").innerText=data.pria+" & "+data.wanita;
document.getElementById("pria").innerText=data.pria;
document.getElementById("wanita").innerText=data.wanita;
document.getElementById("tanggal").innerText=new Date(data.tanggal).toLocaleString();
document.getElementById("tempat").innerText=data.tempat;
document.getElementById("maps").href=data.maps;

// BUKA UNDANGAN
function buka(){
  window.scrollTo({top:window.innerHeight,behavior:'smooth'});
  document.getElementById("music").play();
}

// COUNTDOWN
setInterval(()=>{
  let now=new Date().getTime();
  let target=new Date(data.tanggal).getTime();
  let s=target-now;

  let d=Math.floor(s/(1000*60*60*24));
  let h=Math.floor((s%(1000*60*60*24))/(1000*60*60));

  document.getElementById("countdown").innerText=d+" hari "+h+" jam";
},1000);

// ANIMASI
window.addEventListener("scroll",()=>{
  document.querySelectorAll(".fade").forEach(el=>{
    if(el.getBoundingClientRect().top<window.innerHeight-50){
      el.classList.add("show");
    }
  });
});

</script></body>
</html>
